# Firebase web config values are project identifiers intended for browser use.
# Security comes from Authentication, Rules, App Check and backend validation—not hiding these values.
VITE_FIREBASE_API_KEY=replace_with_your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
VITE_FIREBASE_APP_ID=replace_with_app_id
VITE_FIREBASE_APPCHECK_SITE_KEY=replace_with_recaptcha_enterprise_site_key
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1
